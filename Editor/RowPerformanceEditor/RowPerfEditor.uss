/* ============================================================
   VNovelizer 行演出编辑器 · 样式表 V2（2026-08-26 重写）
   设计目标：紧凑卡片式节点 + 清晰连接边 + 跨平台符号显示

   字体策略：
     - 主字体用 Unity 默认（Inter / Liberation Sans）
     - 符号 fallback 到 Segoe UI Symbol (Win) / Apple Symbols (Mac)
     - 所有 emoji 替换为 Unicode BMP 几何符号

   色彩语义（全局一致）：
     蓝 #4A90D9  系统命令 / 数据列引用
     紫 #9C8FCE  并行（Fork/Join、并行边、进入段泳道）
     绿 #7FAC5B  出口段（@Confirm 链、点击虚线）
     橙 #CC7A29  流程命令（仅可置于链尾）
     土 #8A7A5A  通用节点（无元数据）
     红 #C85A50  致命错误
     黄 #C8A03C  警告
   ============================================================ */

/* ---------------- 全局字体 ---------------- */

.vn-root {
    flex: 1;
    flex-direction: column;
    background-color: #383838;
}

.vn-root Label,
.vn-root Button {
    /* 字体保持 Unity 默认（Inter / Liberation Sans）；
       Unity USS 不支持 font-family 与 'default' 关键字 */
}

/* ---------------- 工具栏 ---------------- */

.vn-toolbar {
    height: 40px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    background-color: #333333;
    border-bottom-width: 1px;
    border-bottom-color: #212121;
}

.vn-toolbar Button {
    height: 26px;
    font-size: 11px;
    color: #CCCCCC;
    background-color: #3E3E3E;
    border-width: 1px;
    border-color: #555555;
    border-radius: 3px;
    margin-left: 0;
    margin-right: 3px;
    padding-left: 8px;
    padding-right: 8px;
}

.vn-toolbar Button:hover {
    background-color: #4E4E4E;
    color: #FFFFFF;
}

.vn-toolbar Button:active {
    background-color: #2A6A9E;
    color: #FFFFFF;
}

.vn-toolbar-divider {
    width: 1px;
    height: 18px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: #555555;
}

.vn-line-summary {
    flex: 1;
    margin-left: 10px;
    margin-right: 10px;
    font-size: 11px;
    color: #909090;
    overflow: hidden;
    -unity-text-align: middle-left;
}

.vn-main {
    flex: 1;
    flex-direction: row;
}

/* ---------------- 状态栏 ---------------- */

.vn-statusbar {
    height: 24px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    background-color: #2A2A2A;
    border-top-width: 1px;
    border-top-color: #212121;
}

.vn-statusbar Label {
    font-size: 11px;
    color: #888888;
    margin-right: 14px;
}

/* ---------------- 行形态徽章 ---------------- */

.vn-rowform-badge {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 9px;
    border-width: 1px;
    font-size: 11px;
    -unity-font-style: bold;
}

.vn-rowform-normal {
    background-color: #33404A;
    border-color: #47607A;
    color: #9EC4E0;
}

.vn-rowform-enhanced {
    background-color: #3E5A2E;
    border-color: #5A8A3E;
    color: #A8D08D;
}

.vn-rowform-custom {
    background-color: #4A3A5E;
    border-color: #7A5FA8;
    color: #C8B0E8;
}

/* ---------------- 左侧命令面板 ---------------- */

.vn-left-panel {
    width: 230px;
    flex-shrink: 0;
    background-color: #333333;
    border-right-width: 1px;
    border-right-color: #212121;
}

.vn-panel-title {
    padding: 7px 10px 7px 10px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #888888;
    letter-spacing: 1px;
    border-bottom-width: 1px;
    border-bottom-color: #2A2A2A;
}

.vn-chain-tabs {
    flex-direction: row;
    background-color: #2A2A2A;
}

.vn-chain-tab {
    flex: 1;
    height: 26px;
    font-size: 11px;
    -unity-font-style: bold;
    color: #888888;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    margin: 0;
}

.vn-chain-tab:hover { color: #CCCCCC; }

.vn-chain-tab--active {
    background-color: #333333;
    color: #DDDDDD;
    border-bottom-color: #4A90D9;
}

.vn-chain-tab--active-confirm {
    background-color: #333333;
    color: #C8E8B0;
    border-bottom-color: #7FAC5B;
}

.vn-cmd-group {
    flex-direction: row;
    align-items: center;
    padding: 5px 10px 3px 10px;
    font-size: 11px;
    -unity-font-style: bold;
    color: #AAAAAA;
}

.vn-cmd-group-dot {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    margin-right: 6px;
}

.vn-cmd-item {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px 4px 22px;
    border-radius: 3px;
    margin-left: 4px;
    margin-right: 4px;
}

.vn-cmd-item:hover { background-color: #2C5D87; }

.vn-cmd-item--dragging {
    background-color: #4A7AAA;
    border-width: 1px;
    border-color: #6A9AD0;
}

.vn-cmd-item-name {
    font-size: 11px;
    color: #B8B8B8;
    -unity-font-style: bold;
}

.vn-cmd-item:hover .vn-cmd-item-name { color: #FFFFFF; }

.vn-cmd-item-sig {
    flex: 1;
    font-size: 9px;
    color: #6A6A6A;
    -unity-text-align: middle-right;
    overflow: hidden;
    margin-left: 6px;
}

.vn-cmd-item--generic .vn-cmd-item-sig { color: #8A7A5A; }

.vn-panel-note {
    margin: 8px 8px 8px 8px;
    padding: 7px;
    font-size: 9px;
    color: #8A9A7A;
    background-color: rgba(127, 172, 91, 0.07);
    border-width: 1px;
    border-color: #3E5A2E;
    border-radius: 4px;
    white-space: normal;
}

/* ---------------- 画布 ---------------- */

.vn-graph {
    flex: 1;
}

/* contentViewContainer 背景必须透明——否则会盖住 GridBackground 的网格线（2026-08-27 用户需求 2） */
.vn-graph > .unity-graph-viewing#contentViewContainer {
    background-color: transparent;
}

/* 网格背景：可见的网格线（2026-08-27 用户需求 2） */
.vn-graph > GridBackground {
    --grid-background-color: rgb(32, 32, 36);
    --line-color: rgba(70, 70, 76, 0.45);
    --thick-line-color: rgba(96, 96, 104, 0.55);
    --spacing: 25;
    --thick-line-every-nth-line: 8;
}

.vn-lane-label {
    position: absolute;
    padding: 2px 10px 2px 10px;
    border-radius: 9px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    background-color: #2B2B2B;
    border-width: 1px;
    border-color: #5A5478;
    /* Unity USS 不支持 border-style: dashed；用半透明色模拟虚线感 */
    opacity: 0.85;
    white-space: nowrap;
}

.vn-lane-entry {
    color: #B0A4DC;
    border-color: #5A5478;
}

.vn-lane-confirm {
    color: #A8D08D;
    border-color: #4A6E3E;
}

/* ---------------- 节点：UE 蓝图风格 ---------------- */

.vn-node {
    /* 2026-08-27（用户需求 4）：加宽——端口回到节点内（left/right:8px）+
       参数显示 name: value 两列（用户需求 6）需要更多横向空间 */
    min-width: 210px;
    max-width: 290px;
    /* R7（Shader Graph 式）：端口在节点内部标题行两端，不溢出边框——
       不再需要 overflow hack（之前贴外方案的历史遗留，已删）。 */
}

.vn-node > #node-border {
    border-radius: 6px;
    border-width: 1px;
    border-color: #1A1A1A;
    background-color: #3A3A3A;
    padding-top: 0;
    padding-bottom: 0;
    /* 2026-08-27（用户反馈端口被切）：min-height 60 = 标题 28 + 内容区 32。
       端口 absolute top:50% 相对 #top，#top 高度 0（无参数时）会让 inputContainer
       被推到 -7px 被标题边框覆盖——min-height 保证 #top 至少 32px。 */
    min-height: 60px;
}

/* 标题栏：分类着色（默认灰）+ 底部白色细线 */
.vn-node > #title {
    height: 28px;
    min-height: 28px;
    padding: 3px 10px 3px 10px;
    background-color: #4A4A4A;
    border-bottom-width: 1px;
    border-bottom-color: #FFFFFF;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    flex-direction: row;
    align-items: center;
    flex-wrap: nowrap;
    overflow: hidden;
}

.vn-node-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin: 0;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.vn-node #contents {
    padding: 4px 0 4px 0;
}

/* ---- 分类标题栏着色（UE 蓝图核心特征） ---- */

.vn-node--cat-system > #title {
    background-color: #2C5D87;
}

.vn-node--cat-performance > #title {
    background-color: #5C5480;
}

.vn-node--cat-flow > #title {
    background-color: #8A5420;
}

.vn-node--cat-logic > #title {
    background-color: #3E7060;
}

.vn-node--cat-audio > #title {
    background-color: #7A5068;
}

.vn-node--cat-generic > #title {
    background-color: #5A5244;
}

/* 分类色带（左侧竖条，保留作为分类色的辅助标识） */
.vn-node-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    background-color: #9C94B2;
}

.vn-accent-system      { background-color: #4A90D9; }
.vn-accent-performance { background-color: #9C94B2; }
.vn-accent-flow        { background-color: #CC7A29; }
.vn-accent-logic       { background-color: #5FA88A; }
.vn-accent-audio       { background-color: #C87FA8; }
.vn-accent-generic     { background-color: #8A7A5A; }

/* ---- 参数行（设计稿式：名+值紧贴左侧，UE 蓝图式） ---- */

.vn-node-params {
    padding: 3px 0 4px 0;
}

.vn-param-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 10px 3px 10px;
    min-height: 18px;
}

.vn-param-key {
    font-size: 11px;
    color: #A0A0A0;
    -unity-text-align: middle-left;
    flex-shrink: 0;
}

.vn-param-value {
    font-size: 11px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin-left: 4px;
    flex-shrink: 0;
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.vn-param-empty {
    font-size: 11px;
    color: #6A6A6A;
    -unity-font-style: italic;
    margin-left: 4px;
    flex-shrink: 0;
}

/* 原始参数（通用节点态） */
.vn-node-rawargs {
    padding: 3px 10px 4px 10px;
    font-size: 10px;
    color: #B8AC90;
    white-space: normal;
}

/* ---------------- 节点：语义角标 ---------------- */

.vn-badge-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.vn-badge {
    padding: 1px 5px 1px 5px;
    margin-left: 4px;
    border-radius: 3px;
    border-width: 1px;
    font-size: 9px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.vn-badge-ref       { background-color: #2C4A66; border-color: #3E6A8E; color: #7FB8E8; }
.vn-badge-noinherit { background-color: #3A3A4A; border-color: #5A5A7E; color: #B0B0D0; }
.vn-badge-flow      { background-color: #5A462C; border-color: #8E6A3E; color: #E8C87F; }
.vn-badge-generic   { background-color: #4A422C; border-color: #7E6E42; color: #D8C89A; }
.vn-badge-blocking  { background-color: #4A2C3E; border-color: #8E4A6A; color: #E8A8C0; }
.vn-badge-nosim     { background-color: #4A3A2C; border-color: #7E5E3E; color: #D8B48A; }

/* ---------------- 节点：状态 ---------------- */

.vn-node--error > #node-border {
    border-color: #C85A50;
    border-width: 2px;
    background-color: #4A3838;
}

.vn-node--warning > #node-border {
    border-color: #C8A03C;
    border-width: 2px;
}

/* Fork/Join 范围高亮（弱化：浅蓝描边 + 淡蓝底，与选中态区分）。
   双类选择器保证特异性高于分类色 / confirm / forkjoin 的背景边框规则。 */
.vn-node.vn-node--range > #node-border {
    border-color: #6A9BC8;
    background-color: rgba(74, 144, 217, 0.10);
}

.vn-node--confirm > #node-border {
    background-color: #3A4A38;
    border-color: #5A8A3E;
}

.vn-node--confirm .vn-node-title { color: #D8E8C8; }

.vn-node--confirm .vn-param-row {
    background-color: rgba(127, 172, 91, 0.06);
}

.vn-node--confirm .vn-param-value { color: #C8D8B8; }

/* 模板影子节点（未持久化，仅视图层） */
.vn-node--template {
    opacity: 0.55;
}

.vn-node--template > #node-border {
    background-color: #3E4854;
    border-color: #6A7A96;
}

/* ---------------- 终端节点（弹头形状，UE 蓝图式） ---------------- */

/* 终端节点公共：弹头 + 白字 */
.vn-terminal {
    min-width: 150px;
    max-width: 200px;
    min-height: 50px;
}

.vn-terminal > #node-border {
    border-width: 2px;
    border-color: #1A1A1A;
    background-color: #4A4A4A;
    padding-top: 0;
    padding-bottom: 0;
    /* 弹头终端 min-height 80 = 标题 50 + 内容 30——端口在弹头下方 #top 中点完整可见 */
    min-height: 80px;
}

.vn-terminal #title {
    border-bottom-width: 0;
    justify-content: center;
    height: 50px;
    min-height: 50px;
    background-color: transparent;
    border-radius: 0;
    padding: 3px 10px 3px 10px;
}

.vn-terminal .vn-node-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.vn-terminal-hint {
    font-size: 10px;
    color: #FFFFFF;
    margin-left: 5px;
}

/* ---- Line Entry：行入口，绿色子弹·左直右圆（无入端口） ---- */
.vn-term--lineentry > #node-border {
    background-color: #6FA84A;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
}

.vn-term--lineentry #title {
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
}

/* ---- Line Exit：行出口，绿色子弹·左圆右直（双端口） ---- */
.vn-term--lineexit > #node-border {
    background-color: #6FA84A;
    border-top-left-radius: 25px;
    border-bottom-left-radius: 25px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

.vn-term--lineexit #title {
    border-top-left-radius: 25px;
    border-bottom-left-radius: 25px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* ---- OnConfirm Entry：确认入口，橙色子弹·左直右圆 ---- */
.vn-term--confirmentry > #node-border {
    background-color: #D17B26;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
}

.vn-term--confirmentry #title {
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
}

/* ---- OnConfirm Exit：确认出口，橙色子弹·左圆右直 ---- */
.vn-term--confirmextit > #node-border {
    background-color: #D17B26;
    border-top-left-radius: 25px;
    border-bottom-left-radius: 25px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

.vn-term--confirmextit #title {
    border-top-left-radius: 25px;
    border-bottom-left-radius: 25px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* ---------------- FORK / JOIN（UE 蓝图式紫色标题） ---------------- */

.vn-forkjoin {
    min-width: 110px;
    max-width: 140px;
}

.vn-forkjoin > #node-border {
    border-radius: 6px;
    background-color: #3A3A3A;
    border-width: 1px;
    border-color: #1A1A1A;
}

.vn-forkjoin #title {
    background-color: #5C5480;
    border-bottom-width: 0;
    justify-content: center;
    height: 26px;
    min-height: 26px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

.vn-forkjoin .vn-node-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 1px;
}

.vn-forkjoin--confirm > #title {
    background-color: #3E5A2E;
}

.vn-forkjoin--confirm .vn-node-title { color: #E8FFD8; }

/* ---------------- 模板折叠胶囊（UE 蓝图式蓝色标题） ---------------- */

.vn-tplcapsule {
    min-width: 300px;
    max-width: 360px;
}

.vn-tplcapsule > #node-border {
    border-radius: 6px;
    background-color: #3A3A3A;
    border-width: 1px;
    border-color: #1A1A1A;
}

.vn-tplcapsule > #title {
    background-color: #2C5D87;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

.vn-tplcapsule .vn-node-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.vn-tpl-expander {
    font-size: 9px;
    color: #8A9AB6;
    margin-right: 5px;
    -unity-font-style: bold;
}

.vn-tpl-count {
    flex: 1;
    font-size: 9px;
    color: #8A9AB6;
    -unity-text-align: middle-right;
}

.vn-tpl-chips {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px 8px 3px 8px;
}

.vn-refchip {
    background-color: #2C4A66;
    border-width: 1px;
    border-color: #3E6A8E;
    border-radius: 3px;
    padding: 1px 5px 1px 5px;
    margin-right: 3px;
    margin-bottom: 3px;
    font-size: 9px;
    color: #7FB8E8;
    -unity-font-style: bold;
}

.vn-refchip--empty {
    background-color: #3A3A3A;
    border-color: #4A4A4A;
    color: #6E6E6E;
    -unity-font-style: italic;
}

.vn-tpl-note {
    padding: 0 8px 6px 8px;
    font-size: 9px;
    color: #8A9AB6;
    white-space: normal;
}

/* =====================================================================
   端口（R7 撤回 → R6 形态 2026-08-27）
   原则：端口在节点内部独立带（左入右出），绝对定位节点内 8px、垂直居中；
         视觉正圆 + 容器 14x14 = connector 同尺寸（消除"方块包裹感"）。
   ===================================================================== */

/* ---- 端口容器：节点内距左/右 8px、垂直居中（百分比 50%） ---- */
.vn-node > #inputContainer,
.vn-node > #outputContainer {
    position: absolute;
    width: 14px;
    height: 14px;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    border-color: transparent;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
}

.vn-node > #inputContainer {
    left: 8px;
    top: 50%;
    margin-top: -8px;
}
.vn-node > #outputContainer {
    right: 8px;
    top: 50%;
    margin-top: -8px;
}

/* ---- Port 元素：流内，清零继承 ---- */
.vn-node Port {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* #type 不占布局空间 */
.vn-node Port > #type {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
}

/* portName Label 即使为空也可能占 flex 空间——彻底隐藏 */
.vn-node Port > Label {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
}

/* ---- #connector：流内正圆（12px 圆 + 2px 边框） ---- */
.vn-node Port > #connector {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border-width: 2px;
    border-color: #1A1A1A;
    background-color: #F0F0F0;
    margin: 0;
    padding: 0;
}

/* ---- #cap：内圈圆点（流内居中，GraphView 默认 absolute 定位在 connector 内） ---- */
.vn-node Port > #connector > #cap {
    left: 3px;
    top: 3px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: #F0F0F0;
    margin: 0;
    padding: 0;
}

/* ---- 端口悬停高亮 ---- */
.vn-node Port:hover > #connector {
    background-color: #FFFFFF;
    border-color: #4A90D9;
}
.vn-node Port:hover > #connector > #cap {
    background-color: #FFFFFF;
}

/* ---- 端口类型颜色 ---- */
/* 并行端口（紫色，Fork/Join 专用） */
.vn-port-par > #connector {
    border-color: #1A1A1A;
    background-color: #9C8FCE;
}
.vn-port-par > #connector > #cap {
    background-color: #9C8FCE;
}
.vn-port-par:hover > #connector {
    background-color: #BCB0E8;
    border-color: #FFFFFF;
}
.vn-port-par:hover > #connector > #cap {
    background-color: #BCB0E8;
}

/* 出口段端口（绿色） */
.vn-port-confirm > #connector {
    border-color: #1A1A1A;
    background-color: #7FAC5B;
}
.vn-port-confirm > #connector > #cap {
    background-color: #7FAC5B;
}
.vn-port-confirm:hover > #connector {
    background-color: #A0CC80;
    border-color: #FFFFFF;
}
.vn-port-confirm:hover > #connector > #cap {
    background-color: #A0CC80;
}

/* ---- Fork/Join 多端口垂直分布 ---- */
/* 当前实现：Fork/Join 用 Port.Capacity.Multi 单端口承载多边，所有节点仍为单端口。
   端口继承 .vn-node 的默认垂直居中规则。预留 .vn-forkjoin--multi 类名供未来真多端口使用。 */
.vn-forkjoin > #inputContainer,
.vn-forkjoin > #outputContainer {
    left: 8px;
    top: 50%;
    margin-top: -8px;
}
.vn-forkjoin > #outputContainer {
    left: auto;
    right: 8px;
}

/* 预留：未来若改用真多 Port 实例（每个分支一个 Port），启用本规则 */
.vn-forkjoin--multi > #inputContainer,
.vn-forkjoin--multi > #outputContainer {
    top: 0;
    margin-top: 0;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
}
.vn-forkjoin--multi > #inputContainer { left: 8px; }
.vn-forkjoin--multi > #outputContainer { right: 8px; }

/* ---------------- 边（UE 蓝图式白色 exec 线） ---------------- */

.vn-graph Edge {
    border-width: 2.5px;
}

.vn-graph Edge.selected {
    border-width: 3.5px;
    border-color: #4A90D9;
}

/* ---------------- 可拖拽列分隔条（2026-08-31） ----------------
   2px 可见细线 + 左右各 2.5px 热区 = 7px 命中宽度。
   1px 的边框线太细抓不住，纯 CSS 无法扩大命中区，故单独做一个元素。 */

.vn-col-resizer {
    width: 7px;
    flex-shrink: 0;
    flex-grow: 0;
    background-color: transparent;
    flex-direction: row;
    justify-content: center;
    cursor: resize-horizontal;
}

.vn-col-resizer-line {
    width: 2px;
    height: 100%;
    background-color: #212121;
}

.vn-col-resizer:hover .vn-col-resizer-line,
.vn-col-resizer--active .vn-col-resizer-line {
    background-color: #4A90D9;
}

/* ---------------- 中右 · 命令链文本编辑器（独立一列） ---------------- */

.vn-textchain-panel {
    width: 360px;
    flex-shrink: 0;
    background-color: #333333;
    border-left-width: 1px;
    border-left-color: #212121;
    flex-direction: column;
}

.vn-textchain-title {
    padding: 8px 12px 8px 12px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #888888;
    letter-spacing: 1px;
    border-bottom-width: 1px;
    border-bottom-color: #2A2A2A;
}

.vn-textchain-section {
    padding: 8px 12px 6px 12px;
    flex-grow: 1;      /* 两段的编辑器平分剩余高度 */
    flex-shrink: 1;
    min-height: 0;     /* 允许被压缩到 min-height 以下，避免溢出时撑破面板 */
}

/* ====== 2026-08-31 重写：IMGUI 自绘代码编辑器 ======
   旧的 UIToolkit 叠层方案（.vn-codefield-*，透明 TextField + 覆盖 Label）
   已整体废弃：TextField 是黑盒，不暴露光标/选区/行布局，必然导致
   光标不可见、选区不可见、长行错位、滚动不同步。
   现在由 VnCodeEditorIMGUI 在 IMGUIContainer 内全自绘，
   所有视觉（背景/行号/着色/选区/光标）都在 C# 里用 EditorGUI.DrawRect + GUI.Label 完成。
   USS 这里只需给容器本身定外框与边距。 */

.vn-codefield-imgui {
    margin-top: 2px;
    margin-bottom: 8px;
    border-radius: 4px;
    overflow: hidden;
    flex-shrink: 0;
}

.vn-textchain-help {
    padding: 8px 12px 12px 12px;
    font-size: 9px;
    color: #7A7A7A;
    white-space: normal;
    border-top-width: 1px;
    border-top-color: #2A2A2A;
    margin-top: auto;
}

/* ---------------- 右侧 Inspector ---------------- */

.vn-inspector {
    width: 284px;
    flex-shrink: 0;
    background-color: #333333;
    border-left-width: 1px;
    border-left-color: #212121;
}

.vn-insp-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px 8px 12px;
    border-bottom-width: 1px;
    border-bottom-color: #2A2A2A;
}

.vn-insp-cmdname {
    font-size: 14px;
    -unity-font-style: bold;
    color: #E8E8E8;
}

.vn-insp-cattag {
    margin-left: 8px;
    padding: 1px 7px 2px 7px;
    border-radius: 3px;
    font-size: 9px;
    background-color: #2C5D87;
    color: #B8D8F0;
}

.vn-insp-section {
    padding: 8px 12px 10px 12px;
    border-bottom-width: 1px;
    border-bottom-color: #2A2A2A;
}

.vn-insp-sectitle {
    font-size: 9px;
    -unity-font-style: bold;
    color: #888888;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.vn-insp-desc {
    font-size: 10px;
    color: #9A9A9A;
    white-space: normal;
    margin-bottom: 4px;
}

.vn-insp-field {
    margin-bottom: 4px;
}

.vn-insp-field Label {
    min-width: 84px;
    font-size: 11px;
    color: #AAAAAA;
}

.vn-insp-bound {
    flex-direction: row;
    align-items: center;
    background-color: #262626;
    border-width: 1px;
    border-color: #3E6A8E;
    border-radius: 3px;
    padding: 3px 8px 3px 8px;
    margin-bottom: 4px;
}

.vn-insp-bound-label {
    flex: 1;
    font-size: 11px;
    color: #8AB8D8;
}

.vn-insp-note {
    padding: 6px 8px 6px 8px;
    border-left-width: 3px;
    border-radius: 0 4px 4px 0;
    font-size: 10px;
    white-space: normal;
}

.vn-insp-note--info {
    background-color: rgba(127, 172, 91, 0.06);
    border-left-color: #5A8A3E;
    color: #8A9A8A;
}

.vn-insp-note--warn {
    background-color: rgba(204, 122, 41, 0.07);
    border-left-color: #8E6A3E;
    color: #C8A87A;
}

.vn-insp-preview {
    background-color: #232323;
    border-width: 1px;
    border-color: #3A3A3A;
    border-radius: 4px;
    padding: 7px 9px 7px 9px;
    font-size: 10px;
    color: #B8C8A8;
    white-space: normal;
}

/* ---------------- 校验消息 ---------------- */

.vn-issue {
    flex-direction: row;
    padding: 4px 7px 4px 7px;
    margin-bottom: 3px;
    border-radius: 3px;
    border-left-width: 3px;
}

.vn-issue--fatal {
    background-color: rgba(200, 90, 80, 0.10);
    border-left-color: #C85A50;
}

.vn-issue--warning {
    background-color: rgba(200, 160, 60, 0.10);
    border-left-color: #C8A03C;
}

.vn-issue-text {
    flex: 1;
    font-size: 10px;
    color: #BEBEBE;
    white-space: normal;
}

.vn-validate-ok {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px 6px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #3E5A2E;
    background-color: rgba(127, 172, 91, 0.08);
}

.vn-validate-ok Label {
    font-size: 10px;
    color: #7FAC5B;
}

/* ---------------- 空状态 ---------------- */

.vn-empty-state {
    flex: 1;
    align-items: center;
    justify-content: center;
}

.vn-empty-state Label {
    font-size: 12px;
    color: #6E6E6E;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 380px;
}

/* ---------------- 拖拽视觉反馈 ---------------- */

.vn-graph--drag-target {
    background-color: #3A4A5E;
}

.vn-drag-hint {
    position: absolute;
    padding: 4px 10px 4px 10px;
    background-color: rgba(74, 144, 217, 0.85);
    color: #FFFFFF;
    font-size: 11px;
    -unity-font-style: bold;
    border-radius: 4px;
    /* Unity USS 不支持 pointer-events: none；用 picking-mode 在 C# 层设置 */
}

/* 框选矩形（自实现 DragBoxSelector 绘制） */
.vn-rect-box {
    position: absolute;
    border-width: 1px;
    border-color: #4A90D9;
    background-color: rgba(74, 144, 217, 0.12);
}
